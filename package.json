{
  "name": "emma",
  "description": "Emma Campás website",
  "homepage": "https://emmacampas.com",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "staticFiles": {
    "staticPath": "./src/static"
  },
  "author": {
    "name": "Diego Caponera",
    "email": "hello@diegocaponera.com",
    "url": "https://www.diegocaponera.com"
  },
  "scripts": {
    "start": "NODE_ENV=dev pnpm concurrently 'pnpm run dev:site' 'pnpm run dev:client'",
    "build": "pnpm run build:site && pnpm run build:client",
    "dev:client": "parcel 'output/**/*.{html,xml}'",
    "dev:site": "pnpm nodemon -e js,json,md,handlebars --watch data --watch src --watch index.js",
    "build:client": "parcel build 'output/**/*.{html,xml}' --public-url $URL",
    "build:site": "node index.js",
    "clean": "rm -rf dist output sanity-dump.json",
    "rosette": "npx nodemon rosette.js"
  },
  "dependencies": {
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@moonwave99/goffre": "^0.1.5",
    "@parcel/config-default": "^2.16.4",
    "@parcel/packager-xml": "^2.16.1",
    "@parcel/transformer-xml": "^2.16.1",
    "@sanity/client": "^7.14.1",
    "baseline-browser-mapping": "^2.9.18",
    "concurrently": "^9.2.1",
    "lodash": "^4.17.21",
    "marked": "^17.0.0",
    "nodemon": "^3.1.11",
    "parcel": "^2.16.1",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "parcel-transformer-html-datasrc": "^1.3.3",
    "sharp": "^0.33.5"
  }
}
