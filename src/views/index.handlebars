{{> quote index=0 dark=true}}

<section class="section bio">
  <div class="container">
    <div class="content">
      {{{ markdown about.content }}}
      <a href="{{url}}{{getNavLink 'about'}}" class="section-link">{{ translate 'homepage.links.about' language }}</a>
    </div>
  </div>
</section>

<section class="section media">
  <div class="container">
    <div class="content">
      <h2>{{ translate 'sections.media' language }}</h2>
      <ul class="videos" data-animate-in>
        <li>
        {{#video}}
          {{> video}}
        {{/video}}
      </li>
      </ul>
      <a href="{{url}}{{getNavLink 'media'}}" class="section-link">{{ translate 'homepage.links.media' language }}</a>
    </div>
  </div>
</section>

<section class="section dates">
  <div class="container">
    <div class="content">
      <h2>{{ translate 'sections.dates' language }}</h2>
      {{> dates dates=nextDates }}
      <a href="{{url}}{{getNavLink 'dates'}}" class="section-link">{{ translate 'homepage.links.dates' language }}</a>
    </div>
  </div>
</section>