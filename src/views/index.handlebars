{{> quote dark=true}}

<section class="section bio">
  <div class="container">
    <div class="content">
      <div data-animate-in>
        <h2>{{translate 'index.intro' @root.language }}</h2>
        <p>{{{ translateSanity intro @root.language }}}</p>
      </div>
      <a href="{{getUrl 'about'}}" class="section-link">{{ translate 'index.links.about' language }}</a>
    </div>
  </div>
</section>

<section class="section media">
  <div class="container">
    <div class="content">
      <div data-animate-in>
      <h2>{{ translate 'sections.media' language }}</h2>
        <ul class="gallery videos">
          {{#videos}}
          <li>
            {{> video-thumbnail}}
          </li>
          {{/videos}}
        </ul>
      </div>
      <a href="{{getUrl 'media'}}" class="section-link">{{ translate 'index.links.media' language }}</a>
    </div>
  </div>
</section>

<section class="section dates">
  <div class="container">
    <div class="content">
      <div data-animate-in>
        <h2>{{ translate 'sections.dates' language }}</h2>
        {{> dates dates=nextDates }}
      </div>
      <a href="{{getUrl 'dates'}}" class="section-link">{{ translate 'index.links.dates' language }}</a>
    </div>
  </div>
</section>