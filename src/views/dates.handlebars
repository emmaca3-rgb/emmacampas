<div class="cover">
  <div class="image"></div>
</div>
<section class="section dates">
  <div class="container">
    <div class="content">
      <header data-animate-in>
        <h1>{{ title }}</h1>
        <p>{{ subtitle}} </p>
      </header>
      {{{content}}}
      <section data-animate-in>
        <h2>{{ translate 'dates.upcoming' language }}</h2>
        {{> dates dates=nextDates}}
      </section>
      <section data-animate-in>
        <h2>{{ translate 'dates.past' language }}</h2>
        {{> dates dates=pastDates}}
      </section>
    </div>
  </div>
</section>
