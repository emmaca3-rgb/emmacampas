<button class="navToggler" aria-label="Toggle Navigation" type="button"></button>
<nav class="nav">
  <ul class="sections">
    {{#each navigation}}
    <li>
      <a class="{{ getNavClass . }}" href="{{ getUrl . }}">{{ getNavLabel . }}</a>
    </li>
    {{/each}}
  </ul>
  <ul class="languages">
    <li>
      <a class="{{geLangClass 'en'}}" href="{{url}}">{{ translate 'languages.english' 'common' }}</a>
    </li>
    <li>
      <a class="{{geLangClass 'de'}}" href="{{url}}/de">{{ translate 'languages.german' 'common' }}</a>
    </li>
    <li>
      <a class="{{geLangClass 'es'}}" href="{{url}}/es">{{ translate 'languages.spanish' 'common' }}</a>
    </li>
    <li>
      <a class="{{geLangClass 'ca'}}" href="{{url}}/ca">{{ translate 'languages.catalan' 'common' }}</a>
    </li>
  </ul>
  <ul class="links">
    <li>
      <a href="{{ links.youtube }}" target="_blank">
        <img alt="Youtube Link" src="~/src/assets/icons/youtube.svg" width="24" height="24"/>
      </a>
    </li>
    <li>
      <a href="{{ links.instagram }}" target="_blank">
        <img alt="Instagram Link" src="~/src/assets/icons/instagram.svg" width="16" height="16"/>
      </a>
    </li>
  </ul>
</nav>