<figure>
  <div class="media-cover-wrapper">
    <img src="https://img.youtube.com/vi/{{id}}/hqdefault.jpg" alt="Preview of {{description}}"/>
    <button class="preview-button" aria-label="{{ translate 'media.preview' language }}" data-preview="video" data-id="{{id}}">
      <img alt="Preview" src="~/src/assets/icons/preview.svg" width="36" height="36" />
    </button>
  </div>
  <figcaption>{{translateSanity title @root.language}}</figcaption>
</figure>