<figure>
  <div class="media-cover-wrapper">
    <img src="{{url}}?w=300&q=100" width="300"alt="{{caption}}"/>
    <button class="preview-button" aria-label="{{ translate 'media.preview' language }}" data-preview="image" data-src="{{url}}">
      <img alt="Preview" src="~/src/assets/icons/preview.svg" width="36" height="36" />
    </button>
  </div>
  <figcaption>{{attribution}}</figcaption>
</figure>