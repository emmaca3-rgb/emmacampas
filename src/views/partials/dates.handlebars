{{#if dates.length}}
<ul class="dates-list">
  {{#each dates}}
  <li>
    <time datetime="{{date}}">{{formatDate date @root.language}}</time>
    {{#if link}}
    <a class="description" href="{{link}}" target="_blank">{{description}}</a>
    {{else}}
    <span class="description">{{description}}</span>
    {{/if}}
    {{#if location}}
    <a class="location" href="{{getLocationLink location}}" target="_blank">{{location}}</a>
    {{/if}}
  </li>
  {{/each}}
</ul>
{{else}}
<p>{{ translate 'dates.none' language }}</p>
{{/if}}
