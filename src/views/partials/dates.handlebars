{{#if dates.length}}
<ul class="dates-list">
  {{#each dates}}
  <li>
    <time datetime="{{date}}">{{formatDate date @root.language}}</time>
    {{#if link}}
    <a href="{{link}}" target="_blank">{{description}}, {{location}}</a>
    {{else}}
    <span>{{description}}, {{location}}</span>
    {{/if}}
  </li>
  {{/each}}
</ul>
{{else}}
<p>{{ translate 'dates.none' language }}</p>
{{/if}}
