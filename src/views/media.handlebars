<div class="cover">
  <div class="image"></div>
</div>
<section class="section media">
  <div class="container">
    <div class="content">
      <header data-animate-in>
        <h1>{{ title }}</h1>
        <p>{{ subtitle}} </p>
      </header>
      <section>
        <h2>{{ translate 'media.videos' language }}</h2>
        <ul class="gallery videos" data-animate-in>
          {{#each videos}}
          <li>
            {{> video-thumbnail }}
          </li>
          {{/each}}
        </ul>
      </section>
      <section>
        <h2>{{ translate 'media.gallery' language }}</h2>
        <ul class="gallery images" data-animate-in>
          {{#each gallery}}
          <li>
            {{> gallery-thumbnail }}
          </li>
          {{/each}}
        </ul>
      </section>
    </div>
  </div>
</section>