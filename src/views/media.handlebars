<div class="cover">
  <div class="image"></div>
</div>
<section class="section media">
  <div class="container">
    <div class="content">
      <header data-animate-in>
        <h1>{{ title }}</h1>
        <p>{{ subtitle}} </p>
      </header>
      <section>
        <h2 id="videos">{{ translate 'media.videos' language }}</h2>
        <ul class="gallery videos" data-animate-in>
          {{#each gallery.videos}}
          <li>
            {{> video-thumbnail }}
          </li>
          {{/each}}
        </ul>
      </section>
      <section>
        <h2 id="images">{{ translate 'media.gallery' language }}</h2>
        <ul class="gallery images" data-animate-in>
          {{#each gallery.pictures}}
          <li>
            {{> gallery-thumbnail }}
          </li>
          {{/each}}
        </ul>
      </section>
      <section>
        <h2 id="appearances">{{ translate 'media.appearances' language }}</h2>
        {{> appearances }}
      </section>
    </div>
  </div>
</section>